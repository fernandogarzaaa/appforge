# =============================================================================
# Clawd Hybrid RTX - Environment Configuration
# Copy this file to .env and fill in your actual API keys
# =============================================================================

# =============================================================================
# API Keys - REQUIRED for cloud fallback functionality
# =============================================================================

# OpenAI API (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your_openai_api_key_here

# Anthropic API (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# Hugging Face Token (https://huggingface.co/settings/tokens)
# Required for downloading gated models
HUGGINGFACE_TOKEN=hf_your_huggingface_token_here

# Optional: OpenRouter for additional model access
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here

# =============================================================================
# GPU / CUDA Configuration
# =============================================================================

# CUDA device selection (0 for first GPU)
CUDA_VISIBLE_DEVICES=0

# CUDA memory management
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512,garbage_collection_threshold:0.6

# Enable CUDA optimizations
CUDA_MODULE_LOADING=LAZY
NCCL_P2P_DISABLE=1  # Disable for RTX 2060 if issues occur

# =============================================================================
# Model Cache Paths
# =============================================================================

# Hugging Face cache directory
HF_HOME=./cache/huggingface
TRANSFORMERS_CACHE=./cache/huggingface

# Model offload directory (for CPU offloading when VRAM full)
OFFLOAD_FOLDER=./cache/offload

# =============================================================================
# Redis Cache Configuration
# =============================================================================

# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# Redis password (if required)
REDIS_PASSWORD=

# Redis SSL
REDIS_SSL=false

# =============================================================================
# Monitoring & Metrics
# =============================================================================

# Prometheus metrics port
PROMETHEUS_PORT=9090
METRICS_ENABLED=true

# Grafana credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_in_production

# Alert webhook (optional)
ALERT_WEBHOOK_URL=

# =============================================================================
# Application Settings
# =============================================================================

# Environment: development, staging, production
ENVIRONMENT=development

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# API server port
API_PORT=8000
API_HOST=0.0.0.0

# Number of workers (RTX 2060: keep at 1 to manage VRAM)
API_WORKERS=1

# =============================================================================
# Hybrid Strategy Settings
# =============================================================================

# Default strategy: local_first, cloud_first, adaptive, cost_optimized
HYBRID_STRATEGY=adaptive

# Daily cloud API budget (USD)
DAILY_CLOUD_BUDGET=10.00

# VRAM threshold for using local model (0.0 - 1.0)
LOCAL_VRAM_THRESHOLD=0.75

# =============================================================================
# Cost Tracking
# =============================================================================

# Enable cost tracking
TRACK_COSTS=true

# Cost per 1K tokens (USD) - customize based on your pricing tier
COST_OPENAI_GPT4=0.03
COST_OPENAI_GPT4_TURBO=0.01
COST_OPENAI_GPT35=0.0015
COST_ANTHROPIC_CLAUDE3_OPUS=0.015
COST_ANTHROPIC_CLAUDE3_SONNET=0.003

# =============================================================================
# Security
# =============================================================================

# JWT Secret for API authentication (generate a secure random string)
JWT_SECRET_KEY=your-256-bit-secret-key-change-in-production

# API key for service-to-service authentication
API_KEY=your-api-key-for-service-auth

# CORS origins (comma-separated, or * for all)
CORS_ORIGINS=*

# =============================================================================
# Performance Tuning (RTX 2060 Specific)
# =============================================================================

# Batch size for inference (reduce if OOM errors)
INFERENCE_BATCH_SIZE=1

# Max sequence length (reduce if OOM errors)
MAX_SEQUENCE_LENGTH=2048

# Enable gradient checkpointing (trades compute for memory)
GRADIENT_CHECKPOINTING=true

# Use 8-bit quantization
USE_8BIT=true

# CPU offload when GPU memory full
CPU_OFFLOAD=true
