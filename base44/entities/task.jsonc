{
    "name": "Task",
    "type": "object",
    "properties": {
        "description": {
            "type": "string",
            "description": "What needs to be done."
        },
        "status": {
            "type": "string",
            "default": "OPEN"
        }
    },
    "required": [
        "description",
        "status"
    ]
}