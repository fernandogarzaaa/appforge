    "build:production": "vite build --mode production",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "preview": "vite preview",
    "swarm:scout": "npx tsx scripts/scout_synergy.ts",
    "swarm:analyze": "npx tsx scripts/analyze_antigravity.ts",
