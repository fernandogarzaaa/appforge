    "swarm:status": "pm2 status",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --config vitest.config.coverage.js --run",
    "test:e2e": "playwright test -c e2e/playwright.config.js",
    "test:e2e:ui": "playwright test -c e2e/playwright.config.js --ui",
    "test:e2e:headed": "playwright test -c e2e/playwright.config.js --headed",
    "test:e2e:debug": "playwright test -c e2e/playwright.config.js --debug",
    "test:all": "npm run test && npm run test:e2e",
    "build:quantum": "cd quantum-core && wasm-pack build --target web --out-dir ../src/quantum-core/pkg",
    "build:quantum:release": "cd quantum-core && wasm-pack build --release --target web --out-dir ../src/quantum-core/pkg",
    "build:analyzer": "cd static-analyzer-core && wasm-pack build --target web --out-dir ../src/static-analyzer-core/pkg",
    "build:analyzer:release": "cd static-analyzer-core && wasm-pack build --release --target web --out-dir ../src/static-analyzer-core/pkg",
    "start:server": "node server.js",
    "deploy": "node scripts/deploy_swarm.js",
    "app:desktop": "electron .",
    "swarm:node": "npx tsx runtime/swarm_node/index.ts"
