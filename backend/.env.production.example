# Backend Production Environment Variables
# Copy this file to .env and update with actual values

# Server Configuration
PORT=5000
NODE_ENV=production
API_URL=https://appforge.fun/api
FRONTEND_URL=https://appforge.fun

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Database Configuration
# Use MongoDB Atlas for production
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/appforge?retryWrites=true&w=majority
DATABASE_NAME=appforge

# CORS Configuration - CRITICAL FOR LOGIN
CORS_ORIGIN=https://appforge.fun
ALLOWED_ORIGINS=https://appforge.fun,https://www.appforge.fun

# Logging
LOG_LEVEL=info

# Redis (for caching and sessions)
REDIS_URL=redis://username:password@hostname:6379/0

# Email Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
SMTP_FROM=noreply@appforge.fun

# Stripe Configuration (for payments)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_public_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Sentry Configuration (for error tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_API_KEY=your_analytics_key

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
API_KEY_SECRET=your-api-key-encryption-secret

# LLM Providers (comma-separated order for fallback)
LLM_PROVIDERS=openai,anthropic,gemini,grok
LLM_PROVIDER_ORDER=openai,anthropic,gemini,grok
LLM_HEALTH_COOLDOWN_MS=120000

# OpenAI (required for quantum mode)
OPENAI_API_KEY=sk_live_your_openai_key
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key

# Google Gemini
GEMINI_API_KEY=your_gemini_key

# X.AI Grok
GROK_API_KEY=your_grok_key

# Quantum LLM configuration
QUANTUM_DEFAULT_MODE=quantum
