# Backend Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Encryption Configuration (for sensitive data like API keys)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-change-this-in-production

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/appforge
DATABASE_NAME=appforge

# Redis Configuration (for BullMQ queues and caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Worker Configuration
WORKER_CONCURRENCY=5

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=debug

# Redis (for caching, sessions, and rate limiting)
REDIS_URL=redis://localhost:6379

# Email Configuration (for future use)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
EMAIL_FROM=noreply@appforge.com

# Third-party Services
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PUBLIC_KEY=pk_test_xxxxx
GITHUB_CLIENT_ID=your-github-id
GITHUB_CLIENT_SECRET=your-github-secret

# Security
SESSION_SECRET=your-session-secret-key
ENCRYPTION_KEY=your-encryption-key-32-chars-long

# Features
ENABLE_NOTIFICATIONS=true
ENABLE_ANALYTICS=true
ENABLE_BACKUP=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
