{
  "name": "appforge-backend",
  "version": "1.0.0",
  "description": "AppForge Backend REST API Server",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "cross-env NODE_ENV=test node --test src/**/*.test.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "migrate": "node scripts/migrate.js",
    "security:audit": "node src/scripts/securityAudit.js",
    "security:audit:ci": "node scripts/ciSecurityAudit.js",
    "rotation:init": "node scripts/initializeRotation.js",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f backend",
    "docker:restart": "docker-compose restart backend",
    "docker:clean": "docker-compose down -v && docker system prune -f"
  },
  "keywords": [
    "express",
    "rest-api",
    "quantum-computing",
    "real-time-collaboration"
  ],
  "author": "AppForge Team",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/exporter-trace-otlp-proto": "^0.51.1",
    "@opentelemetry/instrumentation": "^0.48.1",
    "@opentelemetry/instrumentation-express": "^0.32.2",
    "@opentelemetry/instrumentation-http": "^0.51.1",
    "@opentelemetry/instrumentation-pg": "^0.41.1",
    "@opentelemetry/instrumentation-redis": "^0.35.3",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-trace-node": "^2.0.0",
    "@sentry/node": "^10.38.0",
    "@traceloop/instrumentation-openai": "^0.14.4",
    "axios": "^1.13.4",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "dependency-check": "^5.1.0",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.1",
    "helmet": "^7.2.0",
    "acorn": "^8.14.0",
    "ioredis": "^5.9.2",
    "isomorphic-dompurify": "^2.35.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.22.0",
    "morgan": "^1.10.1",
    "node-fetch": "^3.3.2",
    "pdfkit": "^0.17.2",
    "rate-limit-redis": "^4.3.1",
    "retire": "^4.3.3",
    "socket.io": "^4.8.3",
    "stripe": "^20.3.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "mongodb-memory-server": "^9.5.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.1",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
