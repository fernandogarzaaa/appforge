## Kimi-enhanced version
# ⚡ APPFORGE SWARM CONFIGURATION ⚡
# Copy this file to .env.local and fill in your secrets.

# --- COGNITIVE CORE ---
# Required for Iron Brain and Ghost Brain intelligence
OPENAI_API_KEY=sk-placeholder-key
PERPLEXITY_API_KEY=pplx-placeholder-key

# --- SWARM IDENTITY ---
# Unique identifier for this node in the P2P Mesh
NODE_ID=sovereign-node-alpha
# Port for P2P Resonance (Default: 11435)
SWARM_PORT=11435

# --- QUANTUM ENGINE ---
# Enable/Disable autonomous self-improvement loops
ENABLE_SINGULARITY=true
# Confidence threshold for extensive code modification (0.0 - 1.0)
REALITY_THRESHOLD=0.95

# --- INTEGRATIONS ---
# Optional: For market sensing capabilities
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional: For social swarm features
TWITTER_API_KEY=
DISCORD_BOT_TOKEN=

# --- SECURITY ---
# Master key for admin override (Keep secret!)
ADMIN_SECRET_KEY=change_this_to_something_secure
