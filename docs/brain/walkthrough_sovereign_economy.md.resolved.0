                if (cycleCount % 19 === 0) {
                    results.aiEconomySwarm = await aiEconomySwarm.runCycle();
                }

                // 🕵️ Curiosity Cycle (every 10 cycles - Phase 7)
                if (cycleCount % 10 === 0) {
