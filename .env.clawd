# Clawd Hybrid RTX + OpenRouter Configuration
# Add these to your .env file (DO NOT COMMIT THIS FILE)

# ============================================================================
# CLAWD LLM SERVICE (RTX 2060 + OpenRouter)
# ============================================================================

# URL of your local Clawd Hybrid LLM service
# If running locally on RTX 2060: http://localhost:7860
# If deployed to Hugging Face: https://your-username-cladw-hybrid-rtx.hf.space
VITE_CLAWD_LLM_URL=http://localhost:7860
CLAWD_LLM_URL=http://localhost:7860

# OpenRouter API Key (Free tier - 20 req/min per model)
# Get yours at: https://openrouter.ai/keys
# This enables the 5-model ensemble (Mistral, Gemma, Llama 2, OpenChat, Nous Hermes)
VITE_OPENROUTER_API_KEY=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
OPENROUTER_API_KEY=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

# OpenRouter site configuration (required for free tier)
OPENROUTER_SITE_URL=https://appforge.ai
OPENROUTER_SITE_NAME=AppForge

# ============================================================================
# CUDA / GPU SETTINGS (RTX 2060 6GB)
# ============================================================================

# GPU device selection
CUDA_VISIBLE_DEVICES=0

# Memory optimization for 6GB VRAM
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# Enable CUDA optimizations
CUDA_LAUNCH_BLOCKING=0

# ============================================================================
# CACHE SETTINGS
# ============================================================================

# Semantic cache directory
CACHE_DIR=./cache

# Maximum cache size in GB
MAX_CACHE_SIZE_GB=10

# Similarity threshold for cache hits (0-1)
# Higher = stricter matching, Lower = more hits
SEMANTIC_SIMILARITY_THRESHOLD=0.92

# ============================================================================
# PERFORMANCE SETTINGS
# ============================================================================

# Maximum concurrent requests to OpenRouter
MAX_CONCURRENT_REQUESTS=5

# Batch timeout in milliseconds
BATCH_TIMEOUT_MS=500

# Request timeout in seconds
REQUEST_TIMEOUT_S=30

# Enable response streaming
ENABLE_STREAMING=true

# ============================================================================
# MONITORING
# ============================================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable metrics collection
METRICS_ENABLED=true

# Prometheus metrics port
METRICS_PORT=9090

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable OpenRouter ensemble (5 models)
USE_OPENROUTER_ENSEMBLE=true

# Enable quantum consensus on RTX 2060
USE_QUANTUM_CONSENSUS=true

# Enable semantic caching
USE_SEMANTIC_CACHE=true

# Fallback to base44 if Clawd unavailable
ENABLE_FALLBACK=true

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

# Enable hot reload
HOT_RELOAD=false

# Debug mode
DEBUG=false

# Development port
DEV_PORT=7860
