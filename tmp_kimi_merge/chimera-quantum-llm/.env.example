# Quantum Chimera LLM - Environment Configuration
# ================================================
# Copy this file to .env and fill in your API keys

# Required: OpenRouter API Key
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional: Kimi API Key (for fallback)
# Get yours at: https://platform.moonshot.ai/
KIMI_API_KEY=your_kimi_key_here

# Server Configuration
CHIMERA_HOST=0.0.0.0
CHIMERA_PORT=7860
CHIMERA_DEBUG=false

# Feature Flags
ENABLE_QUANTUM=true
ENABLE_CACHE=true
ENABLE_OPTIMIZER=true
ENABLE_HYPER=true
ENABLE_STREAMING=true
ENABLE_CONVERSATION_MEMORY=true

# Model Configuration
MAX_PRIMARY_MODELS=3
MAX_FALLBACK_MODELS=5
MAX_RETRIES_PER_MODEL=2
REQUEST_TIMEOUT=60

# Cache Configuration
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_MAX_ENTRIES=500
CACHE_TTL_HOURS=24

# Rate Limiting
MAX_CALLS_PER_MINUTE=10

# Model Health
MODEL_COOLDOWN_SECONDS=300

# Conversation Memory
MAX_CONVERSATION_MESSAGES=6

# Response Quality
MIN_QUALITY_SCORE=0.3

# Custom System Prompt (optional)
# CUSTOM_SYSTEM_PROMPT=Your custom system prompt here
