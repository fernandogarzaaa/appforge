# Local development environment variables
# Copy this file to .env.local for your local configuration

# Backend API URL (without /api suffix)
# Use production API
VITE_API_URL=https://appforge.fun/api

# WebSocket URL  
# Use production WebSocket
VITE_WS_URL=wss://appforge.fun

# Enable auto-connect WebSocket on login
VITE_WS_AUTO_CONNECT=true

# API request timeout (milliseconds)
VITE_API_TIMEOUT=15000

# Enable debug mode
VITE_DEBUG_MODE=true

# Enable analytics
VITE_ENABLE_ANALYTICS=false

# Environment
VITE_ENV=development
