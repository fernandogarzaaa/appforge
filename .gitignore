swarm/data/swarm_wallet_backup.json
swarm/data/finance_wallet.json
auth_info_baileys*/
whatsapp_qr*.png
swarm/quantum_channel.json

# State files that should not be committed
bot_memory.json
swarm_state.json
*.key
*.pem
*.p12
*.pfx

